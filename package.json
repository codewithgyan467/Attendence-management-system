{
  "name": "attendance-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend/api"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=api",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=api",
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "npm run start:prod --workspace=api",
    "start:prod": "npm run start:prod --workspace=api"
  },
  "prisma": {
    "schema": "backend/api/prisma/schema.prisma"
  }
}
